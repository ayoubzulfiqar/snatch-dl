# Maintainer: Ayoub Zulfiqar <contact@ayoubzulfiqar.com>
pkgname=snatch-dl
pkgver=2.10.0
pkgrel=1
pkgdesc="Download manager for Linux: aria2, BitTorrent, yt-dlp and gallery-dl behind one GTK4 window"
arch=('x86_64')
url="https://ayoubzulfiqar.com/projects"
license=('custom:snatch')
depends=('gtk4' 'libadwaita' 'aria2')
# Torrents are built in; the rest are only needed for their own features.
optdepends=(
  'ffmpeg: post-processing, conversion and trimming'
  'yt-dlp: site video extraction'
  'gallery-dl: image gallery scraping'
  'wget2: grabbing a whole site recursively'
  'p7zip: unpacking downloaded archives'
)
makedepends=('cargo' 'pkgconf')
# The release profile already strips symbols, so makepkg's debug package
# would be an empty 6 KB file on the release page.
options=('!lto' '!debug')

# Built from the checkout this PKGBUILD ships in.
prepare() {
  cd "${startdir}"
  # --frozen below forbids network access, so every crate must be in the
  # cache first. Without this a clean container fails to build.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "${startdir}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "${startdir}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release --workspace
}

package() {
  cd "${startdir}"
  install -Dm755 "target/release/snatch-gui" "${pkgdir}/usr/bin/snatch-gui"
  install -Dm755 "target/release/snatch-nmh" "${pkgdir}/usr/bin/snatch-nmh"
  install -Dm644 "packaging/com.snatch.dl.desktop" \
    "${pkgdir}/usr/share/applications/com.snatch.dl.desktop"
  local size
  for size in 16 24 32 48 64 96 128 256 512; do
    install -Dm644 "assets/icons/com.snatch.dl-${size}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/com.snatch.dl.png"
  done
  # A custom licence means makepkg will not supply one, so it is installed here.
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "LICENSE-GPL-3.0.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-GPL-3.0.txt"
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"

  # The Chromium WebExtension, ready for "Load unpacked".
  install -Dm644 "extension/manifest.json" \
    "${pkgdir}/usr/share/${pkgname}/extension/manifest.json"
  install -Dm644 "extension/background.js" \
    "${pkgdir}/usr/share/${pkgname}/extension/background.js"
  install -Dm644 "extension/content.js" \
    "${pkgdir}/usr/share/${pkgname}/extension/content.js"

  # Native messaging, registered for every user on the machine. The extension
  # id is pinned by the committed key, so these are static files.
  install -Dm644 "packaging/native-messaging/chromium.json" \
    "${pkgdir}/etc/opt/chrome/native-messaging-hosts/com.snatch.dl.nmh.json"
  install -Dm644 "packaging/native-messaging/chromium.json" \
    "${pkgdir}/etc/chromium/native-messaging-hosts/com.snatch.dl.nmh.json"
  install -Dm644 "packaging/native-messaging/firefox.json" \
    "${pkgdir}/usr/lib/mozilla/native-messaging-hosts/com.snatch.dl.nmh.json"

  # Firefox needs its own manifest but the same background script.
  install -Dm644 "packaging/extension-firefox/manifest.json" \
    "${pkgdir}/usr/share/${pkgname}/extension-firefox/manifest.json"
  install -Dm644 "extension/background.js" \
    "${pkgdir}/usr/share/${pkgname}/extension-firefox/background.js"
  install -Dm644 "extension/content.js" \
    "${pkgdir}/usr/share/${pkgname}/extension-firefox/content.js"

  # Without these the browser shows a letter placeholder instead of the icon.
  local icon
  for icon in 16 24 32 48 128; do
    install -Dm644 "extension/icons/icon-${icon}.png" \
      "${pkgdir}/usr/share/${pkgname}/extension/icons/icon-${icon}.png"
    install -Dm644 "extension/icons/icon-${icon}.png" \
      "${pkgdir}/usr/share/${pkgname}/extension-firefox/icons/icon-${icon}.png"
  done
}
