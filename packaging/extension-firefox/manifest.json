{
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "snatch@snatch.dl",
      "strict_min_version": "115.0"
    }
  },
  "manifest_version": 3,
  "name": "Snatch Download Manager",
  "version": "2.7.2",
  "description": "Hands browser downloads to Snatch, the aria2-powered download manager for Linux.",
  "permissions": [
    "downloads",
    "webRequest",
    "cookies",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Snatch is capturing downloads"
  }
}
