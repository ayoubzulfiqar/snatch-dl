# Rust build output
/target/
**/*.rs.bk

# Generated by install.sh from extension/ — never edit or commit these.
/extension-chromium/
/extension-firefox/

# Chromium extension signing key. This pins the extension ID; committing it
# would let anyone publish an extension that the native host trusts.
*.pem

# Editor and OS noise
.idea/
.vscode/
*.swp
.DS_Store

# Local packaging output
/dist/
/*.rpm
/*.deb
/*.AppImage
/*.tar.gz
