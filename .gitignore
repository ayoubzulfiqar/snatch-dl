# Rust build output
/target/
**/*.rs.bk

# Generated by install.sh from extension/ — never edit or commit this.
# (extension-chromium/ is where older versions staged the Chromium build;
# extension/ is now loaded directly.)
/extension-chromium/
/extension-firefox/

# Private keys never belong in the tree. The extension's *public* key is
# committed in extension/manifest.json, which is all Chromium needs to pin
# the ID of an unpacked extension.
*.pem

# Editor and OS noise
.idea/
.vscode/
*.swp
.DS_Store

# Local packaging output
/dist/
/*.rpm
/*.deb
/*.AppImage
/*.tar.gz
